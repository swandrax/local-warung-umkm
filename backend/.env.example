# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_DATA_API_URL="https://ep-sample.apirest.ap-southeast-2.aws.neon.tech/neondb/rest/v1"

# Cache Configuration (Valkey / Redis) - Optional: Defaults to in-memory fallback
# VALKEY_URL="redis://localhost:6379"

# AI Provider Selection: 'groq' | 'vllm'
AI_PROVIDER="groq"

# Groq Cloud API
GROQ_API_KEY=""

# vLLM Local / Self-Hosted Endpoint (OpenAI-Compatible & Multimodal Vision)
VLLM_BASE_URL="http://localhost:8000/v1"
VLLM_MODEL="meta-llama/Llama-4-Scout-17B-16E"
VLLM_API_KEY="EMPTY"
